{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}"
    },
    {
      "name": "vs",
      "displayName": "Visual Studio (multi-config)",
      "description": "Newest installed Visual Studio, x64. Build with --config Debug|Release.",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "set" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ninja",
      "displayName": "Ninja Multi-Config",
      "description": "Ninja with Debug/Release/RelWithDebInfo in one build tree. On Windows run from a VS developer shell.",
      "inherits": "base",
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "debug",
      "displayName": "Ninja Debug",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Ninja Release",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "lib-only",
      "displayName": "Library only (no examples/tests)",
      "description": "Fast build of just the libraries, e.g. for installing or packaging.",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "IVF2_BUILD_EXAMPLES": "OFF",
        "IVF2_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "vs-debug", "configurePreset": "vs", "configuration": "Debug" },
    { "name": "vs-release", "configurePreset": "vs", "configuration": "Release" },
    { "name": "ninja-debug", "configurePreset": "ninja", "configuration": "Debug" },
    { "name": "ninja-release", "configurePreset": "ninja", "configuration": "Release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "lib-only", "configurePreset": "lib-only" }
  ],
  "testPresets": [
    { "name": "vs-debug", "configurePreset": "vs", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "vs-release", "configurePreset": "vs", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "ninja-debug", "configurePreset": "ninja", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "ninja-release", "configurePreset": "ninja", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
