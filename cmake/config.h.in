#pragma once
/**
 * @file config.h
 * @brief Build configuration of this ivf2 installation (generated by CMake - do not edit).
 *
 * Use the IVF2_HAS_* macros to check at compile time which optional features
 * the library was built with:
 *
 * @code
 * #include <ivf/config.h>
 * #if IVF2_HAS_ASSIMP
 *     auto model = ivf::ModelLoader::loadModel("model.obj");
 * #endif
 * @endcode
 */

#define IVF2_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define IVF2_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define IVF2_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define IVF2_VERSION_PRERELEASE "@IVF2_VERSION_PRERELEASE@"
/// Full semantic version, e.g. "2.0.0-alpha" (pre-release label included).
#define IVF2_VERSION_STRING "@IVF2_VERSION_FULL@"

/// Model loading with assimp (ivf::ModelLoader). CMake option IVF2_WITH_ASSIMP.
#define IVF2_HAS_ASSIMP @IVF2_HAS_ASSIMP@
/// Text rendering with FreeType (ivf::FontManager, ivf::TextNode). CMake option IVF2_WITH_FREETYPE.
#define IVF2_HAS_FREETYPE @IVF2_HAS_FREETYPE@
/// Audio playback and analysis with miniaudio (ivf::AudioManager). CMake option IVF2_WITH_AUDIO.
#define IVF2_HAS_AUDIO @IVF2_HAS_AUDIO@
/// MIDI input with RtMidi (ivf::MidiController). CMake option IVF2_WITH_MIDI.
#define IVF2_HAS_MIDI @IVF2_HAS_MIDI@
/// 2D plots with ImPlot in ImGui windows (ivfui; include <implot.h>). CMake option IVF2_WITH_IMPLOT.
#define IVF2_HAS_IMPLOT @IVF2_HAS_IMPLOT@
