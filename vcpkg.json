{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "ivf2",
  "version-semver": "2.0.0-alpha.3",
  "description": "Interactive Visualisation Framework 2 - a C++23 scene graph library for OpenGL",
  "homepage": "https://github.com/jonaslindemann/ivf2",
  "license": "MIT",
  "$comment-baseline": "Must be a commit that exists in github.com/microsoft/vcpkg (CI clones upstream). Pick it with: git -C <vcpkg> rev-parse origin/master",
  "builtin-baseline": "05925b52317eb9a900a8583782e630aafd7a8929",
  "dependencies": [
    "cgltf",
    "glfw3",
    "glm",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "glfw-binding",
        "opengl3-binding"
      ]
    },
    "nlohmann-json",
    "opengl",
    "stb"
  ],
  "features": {
    "assimp": {
      "description": "Model loading (ivf::ModelLoader) - CMake option IVF2_WITH_ASSIMP",
      "dependencies": [
        "assimp"
      ]
    },
    "freetype": {
      "description": "Text rendering (ivf::TextNode) - CMake option IVF2_WITH_FREETYPE",
      "dependencies": [
        "freetype"
      ]
    },
    "audio": {
      "description": "Audio playback and analysis (ivf::AudioManager) - CMake option IVF2_WITH_AUDIO",
      "dependencies": [
        "miniaudio"
      ]
    },
    "midi": {
      "description": "MIDI input (ivf::MidiController) - CMake option IVF2_WITH_MIDI",
      "dependencies": [
        "rtmidi"
      ]
    },
    "examples": {
      "description": "Dependencies used only by the example programs",
      "dependencies": [
        "reactphysics3d"
      ]
    },
    "implot": {
      "description": "2D plots in ImGui windows (ImPlot) - CMake option IVF2_WITH_IMPLOT",
      "dependencies": [
        "implot"
      ]
    },
    "vtk-xml": {
      "description": "Read VTK XML files (.vtu, .vti) in ivfvis - CMake option IVF2_WITH_VTK_XML",
      "dependencies": [
        "miniz",
        "pugixml"
      ]
    },
    "renoise": {
      "description": "Read Renoise songs (.xrns) in ivfmusic",
      "dependencies": [
        "miniz",
        "pugixml"
      ]
    }
  }
}
